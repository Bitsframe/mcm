# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (keep secret, server-side only)
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_URL=https://your-project-ref.supabase.co


# =============================================================================
# EMAIL SERVICES
# =============================================================================

# Email sender address for broadcast emails
SENDER_BROADCAST_EMAIL=your-email@yourdomain.com

# Email service endpoint URL (e.g., Heroku email service)
NEXT_PUBLIC_EMAIL_SENDER_URL=https://your-email-service.herokuapp.com/send-batch-email
EMAIL_SENDER_URL=https://your-email-service.herokuapp.com/send-batch-email

# Reply-to email address
REPLY_TO_EMAIL=your-reply-email@yourdomain.com

# Resend API Key (for transactional emails)
RESEND_API_KEY=re_your_resend_api_key


# =============================================================================
# AI & AUTOMATION
# =============================================================================

# OpenAI API Key (for AI-powered stock forecasting)
OPENAI_API_KEY=sk-your-openai-api-key


# =============================================================================
# TRANSLATION & LOCALIZATION
# =============================================================================

# i18nexus API Key (for translation management)
I18NEXUS_API_KEY=your-i18nexus-api-key


# =============================================================================
# INTERNAL API KEYS
# =============================================================================

# Internal API keys for cron jobs and automated tasks
INTERNAL_REMINDER_KEY=your-internal-reminder-key
INTERNAL_API_KEY=your-internal-api-key


# =============================================================================
# DEPLOYMENT & HOSTING
# =============================================================================

# Vercel deployment URL (automatically set by Vercel)
VERCEL_URL=your-app.vercel.app

# Public website URL (for generating feedback links, etc.)
NEXT_PUBLIC_USER_WEBSITE=https://your-website.com


# =============================================================================
# STAGING ENVIRONMENT (Optional)
# =============================================================================
# Uncomment these if you have a separate staging environment

# SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
# NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
# NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
