# ============================================
# Copy to .env.local and fill in values
# ============================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Email / Lambda sender (required for send-email flows) ---
# Public base URL of your batch-email service (no secret). Used by client + server.
NEXT_PUBLIC_EMAIL_SENDER_URL=https://your-lambda-or-api.example.com
SENDER_BROADCAST_EMAIL=noreply@example.com
REPLY_TO_EMAIL=support@example.com

# --- Site (required for feedback links in order emails) ---
NEXT_PUBLIC_USER_WEBSITE=https://your-public-site.example.com

# --- Internal APIs (required where used) ---
# Secures server-to-server routes e.g. /api/reminder (x-internal-key)
INTERNAL_API_KEY=your_secure_random_string

# --- OpenAI (required only for /api/stockpanel-AI) ---
OPENAI_API_KEY=your_openai_api_key

# --- SMS via AWS SNS (required for /api/send-sms) ---
# Prefer these names on Amplify (AWS_* is often reserved for custom env vars)
SNS_ACCESS_KEY_ID=your_access_key
SNS_SECRET_ACCESS_KEY=your_secret_key
# Optional local fallbacks only if your host allows AWS_* names:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Smarty (US Street Address API) — optional; appointment address verification ---
# If unset, appointment flow still collects address as plain text (no Smarty call).
SMARTY_AUTH_ID=your_smarty_embedded_auth_id
SMARTY_AUTH_TOKEN=your_smarty_embedded_auth_token

# ============================================
# Not read by this Next.js app (optional / tooling only)
# ============================================
# I18NEXUS_API_KEY=...        # if you run i18nexus-cli against .env.local
# RESEND_API_KEY=...          # not used by Next routes (see supabase/functions if needed)

# ============================================
# Platform-injected (do not set manually)
# ============================================
# VERCEL_URL — set on Vercel for email template base URLs
BRIDGE_URL=
BRIDGE_API_KEY=
