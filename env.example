# ============================================
# IMPORTANT: Copy this file to .env.local
# ============================================
# Next.js uses .env.local for local development
# Copy this file: cp env.example .env.local
# Then fill in your actual values

# ============================================
# Supabase Configuration
# ============================================
# Public Supabase URL (used in client-side code)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Public Supabase Anonymous Key (used in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase URL (used in server-side code, typically same as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=your_supabase_project_url

# Supabase Service Role Key (server-side only - DO NOT expose to client)
# This key has elevated privileges and bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Service Role Key (public - used in some API routes)
# WARNING: Only use if absolutely necessary, prefer SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# Email Configuration
# ============================================
# Email address used as the sender for broadcast emails
SENDER_BROADCAST_EMAIL=noreply@example.com

# Reply-to email address for email replies
REPLY_TO_EMAIL=support@example.com

# Email service URL (server-side, used in API routes)
EMAIL_SENDER_URL=https://your-email-service-url.com

# Email service URL (client-side, must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_EMAIL_SENDER_URL=https://your-email-service-url.com

# ============================================
# AWS Configuration (for SMS)
# ============================================
# AWS Access Key ID for SNS service
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key for SNS service
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ============================================
# Internal API Security
# ============================================
# Internal API key for securing server-to-server endpoints
# Used in routes like /api/reminder
INTERNAL_API_KEY=your_secure_internal_api_key

# ============================================
# OpenAI Configuration
# ============================================
# OpenAI API Key for AI features (e.g., stockpanel-AI)
OPENAI_API_KEY=your_openai_api_key

# ============================================
# Website Configuration
# ============================================
# Public website URL (used in email templates and links)
NEXT_PUBLIC_USER_WEBSITE=https://your-website-url.com
